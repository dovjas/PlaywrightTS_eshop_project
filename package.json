{
  "name": "playwrightts_eshop",
  "version": "1.0.0",
  "description": "Playwight TS eshop project",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:allure": "npm run test && npm run allure:generate && npm run allure:open",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npx allure serve allure-results",
    "test:signup": "npx playwright test --grep @signup",
    "test:login": "npx playwright test --grep @login",
    "test:loginFailed": "npx playwright test --grep @loginFailed",
    "test:contactUsForm": "npx playwright test --grep @contactUsForm",
    "test:subscribe": "npx playwright test --grep @subscribe",
    "test:e2e": "npx playwright test --grep @e2e",
    "test_dev:login": "cross-env TEST_ENV=dev npx playwright test --grep @login"
  },
  "keywords": [
    "pw",
    "ts"
  ],
  "author": "DJ",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/winston": "^2.4.4",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  }
}
